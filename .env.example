# === Telegram Bot ===
# @BotFather se liya hua bot token
BOT_TOKEN=123456789:AAExampleTokenHereReplaceWithReal

# === Telegram API (my.telegram.org se, apne personal account se banega) ===
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# === MongoDB (MongoDB Atlas free tier recommended) ===
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/roxiecloud

# === Channels ===
# DB Channel: jahan bot files store karega (bot must be admin here)
# ID nikalne ke liye: channel me koi bhi msg forward karo bot ko, phir /getid reply karo
DB_CHANNEL_ID=-1001234567890

# FSUB Channel: jahan users ko join karna mandatory hoga (bot must be admin here)
FSUB_CHANNEL_ID=-1009876543210
FSUB_INVITE_LINK=https://t.me/+xxxxxxxxxxxx

# === Admin Access ===
# Comma-separated Telegram user IDs jo /admin panel access kar sakte hain
# Apna ID nikalne ke liye @userinfobot ko /start karo
ADMIN_IDS=111111111,222222222
